---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { bySurname } from '../lib/papers';

const everyone = (await getCollection('people')).sort((a, b) => a.data.order - b.data.order);
const pi = everyone.find((p) => p.data.group === 'pi')!;
// everyone except the PI and alumni, in one grid, alphabetical by surname
const team = everyone.filter((p) => p.data.group !== 'pi' && p.data.group !== 'alumni').sort(bySurname);
const alumni = everyone.filter((p) => p.data.group === 'alumni').sort(bySurname);
// Life-in-the-lab gallery, shown newest first. `date` drives the order; photos
// without a known date carry an estimate (approx: true) — correct these as needed.
const photos = [
  { src: '/lab/group-picnic-2025.webp', alt: 'Lab picnic', date: '2025-06', approx: true },
  { src: '/lab/group-holiday-2024.webp', alt: 'Holiday party', date: '2024-12' },
  { src: '/lab/group-picnic-2024.webp', alt: 'Lab picnic', date: '2024-06' },
  { src: '/lab/group-picnic-2023.webp', alt: 'Lab picnic', date: '2023-06' },
  { src: '/lab/group-2022.webp', alt: 'Lab picnic', date: '2022-06' },
  { src: '/lab/hike-stairs-2021.webp', alt: 'Lab hike', date: '2021-08', approx: true, tall: true },
  { src: '/lab/san-diego-ballast-point.webp', alt: 'Conference trip, San Diego', date: '2018-10', approx: true },
  { src: '/lab/hike-madrone-fire-road.webp', alt: 'Lab hike, Madrone Fire Road', date: '2018-07', approx: true },
  { src: '/lab/hike-ridge.webp', alt: 'Lab hike', date: '2018-07', approx: true, tall: true },
  { src: '/lab/lake-dock.webp', alt: 'Lab outing at the lake', date: '2017-06', approx: true },
].sort((a, b) => b.date.localeCompare(a.date));
const photoYear = (p: { date: string; approx?: boolean }) => `${p.approx ? 'c. ' : ''}${p.date.slice(0, 4)}`;
const initials = (n: string) => n.split(' ').filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).slice(0, 2).join('');
const linkLabel: Record<string, string> = { profile: 'Stanford Profile', orcid: 'ORCID', pubmed: 'PubMed', github: 'GitHub', website: 'Website', scholar: 'Scholar' };
---
<Base title="People" description="Members and alumni of the Quertermous Lab at Stanford Cardiovascular Medicine.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">People</span>
      <h1>The team</h1>
      <p class="lede">Physician-scientists, geneticists, computational biologists and bench scientists working together on the biology of the artery wall.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article id={pi.id} class="pi card reveal">
        <img src={pi.data.photo} alt={pi.data.name} />
        <div class="pi__body">
          <span class="eyebrow">Principal investigator</span>
          <h2>{pi.data.name}, {pi.data.degrees}</h2>
          <p class="pi__role">{pi.data.role} · Director of Research, Division of Cardiovascular Medicine<br />
            Member, Stanford Cardiovascular Institute and Bio-X</p>
          <p>{pi.data.bio}</p>
          <p class="links">
            {pi.data.email && <a href={`mailto:${pi.data.email}`}>{pi.data.email}</a>}
            {Object.entries(pi.data.links).map(([k, v]) => <a href={v}>{linkLabel[k] ?? k}</a>)}
          </p>
        </div>
      </article>

      <div class="members">
        {team.map((p) => (
            <article id={p.id} class="member card reveal">
              {p.data.photo ? <img src={p.data.photo} alt={p.data.name} loading="lazy" /> : <div class="member__ph">{initials(p.data.name)}</div>}
              <div class="member__body">
                <h3>{p.data.name}{p.data.degrees && <span>, {p.data.degrees}</span>}</h3>
                <p class="member__role">{p.data.role}</p>
                {p.data.focus && <p class="member__focus">{p.data.focus}</p>}
                {p.data.bio && (
                  <details>
                    <summary>Bio</summary>
                    <p>{p.data.bio}</p>
                  </details>
                )}
                {(p.data.email || Object.keys(p.data.links).length > 0) && (
                  <p class="links">
                    {p.data.email && <a href={`mailto:${p.data.email}`}>Email</a>}
                    {Object.entries(p.data.links).map(([k, v]) => <a href={v}>{linkLabel[k] ?? k}</a>)}
                  </p>
                )}
              </div>
            </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <details class="alumni-box reveal">
        <summary>
          <span>
            <span class="eyebrow">Alumni</span>
            <strong>Lab alumni ({alumni.length})</strong>
            <span class="muted">Former trainees and scientists now leading research groups, clinical programs and companies around the world.</span>
          </span>
          <span class="alumni-box__btn" aria-hidden="true"></span>
        </summary>
        <ul class="alumni">
          {alumni.map((a) => (
            <li>
              <strong>{a.data.links.website ? <a href={a.data.links.website}>{a.data.name}</a> : a.data.name}{a.data.degrees && <span>, {a.data.degrees}</span>}</strong>
              {a.data.subsequentPosition && <span>{a.data.subsequentPosition}</span>}
              {a.data.role && a.data.role !== 'Lab alumnus' && <em>In lab: {a.data.role}</em>}
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal"><div><span class="eyebrow">Life in the lab</span><h2>Picnics, parties &amp; hikes</h2></div></div>
      <div class="gallery">
        {photos.map((p) => <figure class:list={['reveal', { tall: p.tall }]}><img src={p.src} alt={`${p.alt}, ${photoYear(p)}`} loading="lazy" /><figcaption>{p.alt} · {photoYear(p)}</figcaption></figure>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .pi { display: grid; grid-template-columns: 300px 1fr; gap: 0; margin-bottom: 72px; scroll-margin-top: 96px; }
  .pi img { width: 100%; aspect-ratio: 4 / 5; height: auto; object-fit: cover; object-position: 50% 20%; }
  .pi__body { padding: 36px 40px; }
  .pi__role { color: var(--muted); font-size: .95rem; }
  .pi__body > p:not(.pi__role):not(.links) { color: var(--ink-2); }
  @media (max-width: 800px) { .pi { grid-template-columns: 1fr; } .pi img { max-height: 380px; } .pi__body { padding: 26px; } }

  .members { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 22px; }
  .member { display: flex; flex-direction: column; scroll-margin-top: 96px; transition: box-shadow .3s; }
  .member:target { box-shadow: 0 0 0 3px var(--artery), var(--shadow-lg); }
  .member img, .member__ph { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .member__ph { display: grid; place-items: center; font-family: var(--font-serif); font-size: 3rem; color: #fff;
    background: radial-gradient(circle at 30% 25%, rgba(239,64,86,.7), transparent 60%), radial-gradient(circle at 80% 80%, rgba(42,74,134,.8), transparent 55%), var(--blood-night); }
  .member__body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .member h3 { font-size: 1.15rem; margin: 0; }
  .member h3 span { font-family: var(--font-sans); font-weight: 500; font-size: .85rem; color: var(--muted); }
  .member__role { color: var(--artery); font-weight: 600; font-size: .88rem; margin: 0; }
  .member__focus { font-size: .88rem; color: var(--ink-2); margin: 6px 0 0; }
  details { margin-top: 8px; font-size: .88rem; color: var(--ink-2); }
  summary { cursor: pointer; font-weight: 600; color: var(--ink); font-size: .85rem; }
  details p { margin: 8px 0 0; }
  .links { display: flex; gap: 14px; flex-wrap: wrap; font-size: .88rem; font-weight: 600; margin: 10px 0 0; }
  .links a { text-decoration: none; }

  .alumni-box { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .alumni-box summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 30px; }
  .alumni-box summary::-webkit-details-marker { display: none; }
  .alumni-box summary > span:first-child { display: flex; flex-direction: column; gap: 4px; }
  .alumni-box summary strong { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 600; }
  .alumni-box .eyebrow { margin-bottom: 2px; }
  .alumni-box__btn { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--artery); position: relative; transition: all .3s; }
  .alumni-box__btn::before, .alumni-box__btn::after { content: ''; position: absolute; left: 50%; top: 50%; width: 16px; height: 2px; background: var(--artery); transform: translate(-50%, -50%); transition: transform .3s; }
  .alumni-box__btn::after { transform: translate(-50%, -50%) rotate(90deg); }
  .alumni-box[open] .alumni-box__btn { background: var(--artery); }
  .alumni-box[open] .alumni-box__btn::before, .alumni-box[open] .alumni-box__btn::after { background: #fff; }
  .alumni-box[open] .alumni-box__btn::after { transform: translate(-50%, -50%) rotate(0deg); }
  .alumni-box summary:hover .alumni-box__btn { box-shadow: 0 0 0 4px rgba(200,36,58,.15); }
  .alumni { padding: 0 30px 24px !important; border-top: 1px solid var(--line); }
  .alumni { list-style: none; padding: 0; margin: 0; columns: 3 280px; column-gap: 40px; }
  .alumni li { break-inside: avoid; padding: 12px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 2px; }
  .alumni strong { font-weight: 600; }
  .alumni strong a { color: var(--ink); text-decoration: none; }
  .alumni strong a:hover { color: var(--artery); }
  .alumni strong span { font-weight: 400; color: var(--muted); font-size: .85rem; }
  .alumni li > span { font-size: .88rem; color: var(--ink-2); }
  .alumni em { font-size: .8rem; color: var(--muted); }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 230px; gap: 18px; }
  .gallery figure { margin: 0; border-radius: var(--radius); overflow: hidden; position: relative; }
  .gallery figure.tall { grid-row: span 2; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; transition: transform .6s var(--ease); }
  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 200px; } }
  @media (max-width: 560px) { .gallery { grid-template-columns: 1fr; grid-auto-rows: 240px; } .gallery figure.tall { grid-row: span 2; } }
  .gallery figure:hover img { transform: scale(1.03); }
  .gallery figcaption { position: absolute; left: 12px; bottom: 12px; background: rgba(20,7,11,.7); color: #fff; font-size: .8rem; padding: 4px 10px; border-radius: 999px; }
</style>
