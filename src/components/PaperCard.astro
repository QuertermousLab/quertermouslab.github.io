---
// Visual card for a highlighted paper (image + journal + title + summary).
import type { Paper } from '../lib/papers';
import { getLabKeys, shortAuthors, isPreprint } from '../lib/papers';
interface Props { paper: Paper; compact?: boolean }
const { paper, compact = false } = Astro.props;
const d = paper.data;
const keys = await getLabKeys();
---
<article class:list={['pcard card reveal', { 'pcard--compact': compact }]}>
  <a class="pcard__media" href={d.url} aria-hidden="true" tabindex="-1">
    {d.image ? <img src={d.image} alt="" loading="lazy" /> : (
      <div class="pcard__placeholder"><span>{d.journalAbbrev}</span></div>
    )}
  </a>
  <div class="pcard__body">
    <div class="pcard__meta">
      <span class:list={['chip', { 'chip--red': !isPreprint(paper) }]}>{d.journalAbbrev}</span>
      <span class="muted">{d.year}</span>
      {d.collaborative && <span class="chip">Collaboration</span>}
    </div>
    <h3><a href={d.url}>{d.title}</a></h3>
    {!compact && d.summary && <p class="pcard__summary">{d.summary}</p>}
    <p class="pcard__authors" set:html={shortAuthors(d.authors, keys)} />
    <div class="pcard__links">
      <a href={d.url}>Paper →</a>
      {d.dataUrl && <a href={d.dataUrl}>Data</a>}
      {d.geo && <a href={`https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=${d.geo}`}>{d.geo}</a>}
      {d.codeUrl && <a href={d.codeUrl}>Code</a>}
    </div>
  </div>
</article>

<style>
  .pcard { display: flex; flex-direction: column; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }
  .pcard:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .pcard__media { display: block; aspect-ratio: 16 / 10; background: #fff; overflow: hidden; border-bottom: 1px solid var(--line); }
  .pcard__media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .6s var(--ease); }
  .pcard:hover .pcard__media img { transform: scale(1.04); }
  .pcard__placeholder { width: 100%; height: 100%; display: grid; place-items: center;
    background: radial-gradient(circle at 30% 30%, rgba(239,64,86,.55), transparent 55%), radial-gradient(circle at 80% 80%, rgba(42,74,134,.6), transparent 50%), var(--blood-night); }
  .pcard__placeholder span { font-family: var(--font-serif); font-style: italic; color: #fff; font-size: 1.4rem; opacity: .9; }
  .pcard__body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
  .pcard__meta { display: flex; gap: 8px; align-items: center; font-size: .85rem; margin-bottom: 10px; flex-wrap: wrap; }
  .pcard h3 { font-size: 1.12rem; line-height: 1.3; margin-bottom: 10px; }
  .pcard h3 a { color: var(--ink); text-decoration: none; }
  .pcard h3 a:hover { color: var(--artery); }
  .pcard__summary { font-size: .93rem; color: var(--ink-2); }
  .pcard__authors { font-size: .8rem; color: var(--muted); line-height: 1.45; margin-bottom: 14px; }
  .pcard__authors :global(b) { color: var(--ink-2); font-weight: 600; }
  .pcard__links { margin-top: auto; display: flex; gap: 14px; font-size: .85rem; font-weight: 600; flex-wrap: wrap; }
  .pcard__links a { text-decoration: none; }
  .pcard--compact .pcard__media { aspect-ratio: 16 / 9; }
</style>
