---
/**
 * Abstract, hand-built illustrations for the four research themes.
 * Deterministic (seeded) so builds are stable. viewBox 640 × 400.
 */
interface Props { kind: 'locus' | 'smc' | 'atlas' | 'perturb'; class?: string }
const { kind, class: cls = '' } = Astro.props;

let seed = kind.length * 977 + 13;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const g = () => (rnd() + rnd() + rnd() - 1.5) / 1.5;
const f = (n: number) => n.toFixed(1);

const C = {
  red: '#c8243a', bright: '#ef4056', cardinal: '#8c1515', vein: '#2a4a86', veinSoft: '#7f9be0',
  plaque: '#e7a93b', fmc: '#f28c6b', cmc: '#9b6ee6', endo: '#2a9d8f', ink: '#1a1519', muted: '#8a7f85',
  line: '#e2d8d4', grey: '#cfc5c9', grey2: '#b7adb2',
};

// ---------- locus: Manhattan plot → enhancer–promoter loop ----------
const manhattan: { x: number; y: number; c: string }[] = [];
if (kind === 'locus') {
  const chrom = 12;
  for (let k = 0; k < chrom; k++) {
    const x0 = 44 + k * 46;
    for (let i = 0; i < 26; i++) {
      const x = x0 + rnd() * 40;
      const peak = k === 6 ? Math.exp(-(((x - (x0 + 20)) / 7) ** 2)) : 0;
      const h = Math.max(-Math.log10(rnd()) * 11, 0) + peak * (80 + rnd() * 18);
      manhattan.push({ x, y: 128 - Math.min(h, 102), c: peak > 0.35 ? C.red : k % 2 ? C.grey2 : C.grey });
    }
  }
}
const peakPath = (x0: number, peaks: [number, number, number][], base: number) => {
  let d = `M${x0} ${base}`;
  for (let x = x0; x <= 600; x += 3) {
    let y = 0;
    for (const [px, h, w] of peaks) y += h * Math.exp(-(((x - px) / w) ** 2));
    y += rnd() * 1.6;
    d += ` L${x} ${f(base - y)}`;
  }
  return d + ` L600 ${base} Z`;
};

// ---------- smc: branching cell-state trajectory ----------
const traj: { x: number; y: number; c: string; r: number }[] = [];
if (kind === 'smc') {
  const mix = (a: string, b: string, t: number) => {
    const p = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    const [x, y] = [p(a), p(b)];
    return `rgb(${x.map((v, i) => Math.round(v + (y[i] - v) * t)).join(',')})`;
  };
  for (let i = 0; i < 520; i++) {
    const t = rnd();
    const branch = rnd() < 0.5 ? -1 : 1;
    // stem from (120,200) to (300,200), then branches up to (520,95) or down to (520,305)
    let x: number, y: number, c: string;
    if (t < 0.4) {
      const s = t / 0.4;
      x = 105 + s * 200; y = 200 + g() * (26 - s * 6); c = mix(C.red, '#e8645a', s * 0.6);
    } else {
      const s = (t - 0.4) / 0.6;
      x = 305 + s * 215; y = 200 + branch * (s ** 0.9) * 108 + g() * 18;
      c = mix('#e8645a', branch < 0 ? C.fmc : C.cmc, Math.min(1, s * 1.3));
    }
    traj.push({ x: x + g() * 8, y, c, r: 2 + rnd() * 1.6 });
  }
}

// ---------- atlas: arterial tree + UMAP ----------
const umap: { x: number; y: number; c: string }[] = [];
if (kind === 'atlas') {
  const clusters = [
    { x: 470, y: 120, sx: 38, sy: 24, c: C.red, n: 170 },     // SMC
    { x: 560, y: 200, sx: 26, sy: 34, c: C.veinSoft, n: 140 }, // fibroblast
    { x: 450, y: 270, sx: 30, sy: 20, c: C.endo, n: 110 },     // endothelial
    { x: 560, y: 320, sx: 16, sy: 14, c: C.plaque, n: 50 },    // immune
    { x: 395, y: 190, sx: 14, sy: 14, c: C.cmc, n: 40 },       // pericyte / other
  ];
  for (const k of clusters) for (let i = 0; i < k.n; i++) umap.push({ x: k.x + g() * k.sx, y: k.y + g() * k.sy, c: k.c });
}

// ---------- perturb: heatmap ----------
const heat: { x: number; y: number; v: number }[] = [];
if (kind === 'perturb') {
  for (let i = 0; i < 10; i++) for (let j = 0; j < 12; j++) {
    const block = (i < 4 && j < 5) ? 0.9 : (i >= 5 && i < 8 && j >= 6 && j < 10) ? -0.85 : 0;
    heat.push({ x: j, y: i, v: Math.max(-1, Math.min(1, block + g() * 0.35)) });
  }
}
const heatColor = (v: number) => v > 0 ? `rgba(200,36,58,${(0.12 + v * 0.85).toFixed(2)})` : `rgba(42,74,134,${(0.12 - v * 0.85).toFixed(2)})`;
const guides = [C.red, C.vein, C.plaque, C.endo, C.cmc, C.fmc];
---
<svg class={cls} viewBox="0 0 640 400" role="img" aria-label={`Illustration: ${kind}`} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id={`bg-${kind}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fffaf8" /><stop offset="1" stop-color="#f6eeea" />
    </linearGradient>
    <marker id={`arr-${kind}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill={C.ink} opacity=".55" />
    </marker>
  </defs>
  <rect width="640" height="400" fill={`url(#bg-${kind})`} />
  <g font-family="Figtree Variable, system-ui, sans-serif" font-size="12" fill={C.muted}>

  {kind === 'locus' && (
    <g>
      <text x="40" y="22" font-weight="700" letter-spacing="1.5" font-size="10.5">CAD GWAS</text>
      <line x1="40" y1="62" x2="604" y2="62" stroke={C.red} stroke-dasharray="4 4" opacity=".45" />
      {manhattan.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="2.3" fill={p.c} />)}
      <line x1="40" y1="131" x2="604" y2="131" stroke={C.line} />
      <path d="M312 134 L340 134 L600 186 L40 186 Z" fill={C.red} opacity=".06" />
      <!-- chromatin loop -->
      <path d="M200 262 C 228 170, 402 170, 432 262" fill="none" stroke={C.red} stroke-width="2.4" stroke-dasharray="1 5" stroke-linecap="round" />
      <text x="316" y="190" text-anchor="middle" font-size="11">3D contact (HiChIP)</text>
      <!-- DNA -->
      <line x1="40" y1="268" x2="604" y2="268" stroke={C.ink} stroke-width="2" opacity=".6" />
      <rect x="172" y="258" width="58" height="20" rx="6" fill={C.plaque} opacity=".9" />
      <text x="201" y="296" text-anchor="middle" font-weight="600" fill={C.ink}>enhancer</text>
      <!-- TF bound to enhancer -->
      <ellipse cx="190" cy="248" rx="15" ry="11" fill={C.endo} opacity=".92" />
      <text x="190" y="252" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">TF</text>
      <!-- SNP -->
      <line x1="216" y1="258" x2="216" y2="226" stroke={C.cardinal} stroke-width="1.6" />
      <circle cx="216" cy="222" r="6.5" fill={C.bright} stroke="#fff" stroke-width="2" />
      <text x="228" y="216" font-size="11" fill={C.cardinal} font-weight="600">risk variant</text>
      <!-- gene -->
      <path d="M432 268 V244 H452" fill="none" stroke={C.ink} stroke-width="1.8" marker-end={`url(#arr-${kind})`} />
      {[[436, 22], [470, 14], [496, 26], [534, 12], [560, 30]].map(([x, w]) => <rect x={x} y="259" width={w} height="18" rx="2" fill={C.vein} />)}
      <text x="512" y="296" text-anchor="middle" font-weight="600" fill={C.ink}>causal gene</text>
      <!-- tracks -->
      <text x="40" y="330" font-size="10.5" font-weight="700" letter-spacing="1">ATAC</text>
      <path d={peakPath(90, [[201, 22, 9], [438, 26, 7], [330, 6, 14]], 336)} fill={C.red} opacity=".75" />
      <text x="40" y="362" font-size="10.5" font-weight="700" letter-spacing="1">TF ChIP</text>
      <path d={peakPath(90, [[195, 20, 6], [300, 5, 8]], 368)} fill={C.endo} opacity=".8" />
      <text x="40" y="392" font-size="10.5" font-weight="700" letter-spacing="1">CRISPRi</text>
      <rect x="172" y="381" width="58" height="10" rx="3" fill={C.cardinal} opacity=".85" />
      <text x="240" y="390" font-size="10.5">silencing the enhancer lowers the gene</text>
    </g>
  )}

  {kind === 'smc' && (
    <g>
      {traj.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r={f(p.r)} fill={p.c} opacity=".55" />)}
      <path d="M100 200 H300 C 380 200, 420 120, 530 96" fill="none" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      <path d="M300 200 C 380 200, 420 280, 530 304" fill="none" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      <!-- contractile SMC -->
      <g transform="translate(78 200)">
        <path d="M-48 0 C -30 -15, 30 -15, 48 0 C 30 15, -30 15, -48 0 Z" fill={C.red} />
        <ellipse rx="13" ry="5" fill="#fff" opacity=".85" />
        {[-30, -18, 18, 30].map((x) => <line x1={x} y1="-6" x2={x + 6} y2="6" stroke="#fff" stroke-width="1" opacity=".35" />)}
      </g>
      <text x="78" y="238" text-anchor="middle" font-weight="700" fill={C.ink} font-size="13">Contractile SMC</text>
      <!-- fibromyocyte -->
      <g transform="translate(572 72)">
        {[-12, -4, 4, 12].map((y) => <path d={`M-52 ${y} Q 0 ${y - 6} 52 ${y}`} stroke={C.fmc} stroke-width="1.2" fill="none" opacity=".6" />)}
        <path d="M-40 0 C -24 -12, 24 -12, 40 0 C 24 12, -24 12, -40 0 Z" fill={C.fmc} />
        <ellipse rx="10" ry="4.5" fill="#fff" opacity=".85" />
      </g>
      <text x="572" y="112" text-anchor="middle" font-weight="700" fill={C.ink} font-size="13">Fibromyocyte</text>
      <text x="572" y="128" text-anchor="middle" font-size="11">stabilizes the fibrous cap</text>
      <!-- chondromyocyte -->
      <g transform="translate(572 318)">
        <circle r="30" fill={C.cmc} opacity=".2" />
        <circle r="21" fill={C.cmc} />
        <circle r="8" fill="#fff" opacity=".85" />
        {[[-26, -12], [24, 16], [-18, 24], [28, -14], [4, -30]].map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="#fff" stroke={C.cmc} stroke-width="1" />)}
      </g>
      <text x="572" y="370" text-anchor="middle" font-weight="700" fill={C.ink} font-size="13">Chondromyocyte</text>
      <text x="572" y="386" text-anchor="middle" font-size="11">drives calcification</text>
      <!-- regulators -->
      <g font-size="11.5" font-weight="700">
        <rect x="362" y="118" width="84" height="24" rx="12" fill="#fff" stroke={C.fmc} />
        <text x="404" y="134" text-anchor="middle" fill={C.cardinal}>TCF21 →</text>
        <rect x="336" y="258" width="112" height="24" rx="12" fill="#fff" stroke={C.cmc} />
        <text x="392" y="274" text-anchor="middle" fill={C.vein}>SMAD3 · AHR ⊣</text>
        <rect x="408" y="296" width="84" height="24" rx="12" fill="#fff" stroke={C.cmc} />
        <text x="450" y="312" text-anchor="middle" fill={C.cardinal}>PDGFD →</text>
      </g>
      <text x="200" y="176" text-anchor="middle" font-size="11" letter-spacing="1" font-weight="700">PHENOTYPIC MODULATION</text>
    </g>
  )}

  {kind === 'atlas' && (
    <g>
      <!-- arterial tree -->
      <g fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M168 300 C 160 250, 160 180, 190 140 C 214 110, 262 110, 280 150 C 292 180, 290 220, 290 260 L 290 330 C 290 345, 282 356, 268 372 M290 330 C 292 345, 300 356, 314 372"
              stroke={C.red} stroke-width="16" />
        <path d="M168 300 C 160 250, 160 180, 190 140 C 214 110, 262 110, 280 150 C 292 180, 290 220, 290 260 L 290 330 C 290 345, 282 356, 268 372 M290 330 C 292 345, 300 356, 314 372"
              stroke="#fff" stroke-width="4" opacity=".35" />
        <path d="M205 124 C 200 90, 196 60, 194 34" stroke={C.red} stroke-width="8" />
        <path d="M232 116 C 234 86, 238 60, 242 34" stroke={C.red} stroke-width="8" />
        <path d="M258 122 C 280 100, 310 92, 340 90" stroke={C.red} stroke-width="7" />
        <path d="M150 292 C 120 280, 104 256, 96 226" stroke={C.vein} stroke-width="12" />
        <path d="M166 312 C 150 330, 132 336, 116 332" stroke={C.red} stroke-width="5" />
      </g>
      <path d="M140 300 C 130 330, 150 360, 184 366 C 214 370, 232 344, 226 316 C 220 296, 192 286, 166 290 Z" fill={C.cardinal} opacity=".9" />
      {([
        [194, 40, 'Carotid', 'l'], [242, 40, '', ''], [226, 112, 'Arch', 'u'], [176, 190, 'Ascending', 'r'], [168, 282, 'Root', 'r'],
        [118, 332, 'Coronary', 'l'], [100, 232, 'Pulmonary', 'l'], [292, 214, 'Descending', 'r'], [290, 312, 'Infrarenal', 'r'], [312, 370, 'Iliac', 'r'],
      ] as [number, number, string, string][]).map(([x, y, l, side]) => (
        <g>
          <circle cx={x} cy={y} r="7" fill="#fff" stroke={C.ink} stroke-width="1.6" />
          <circle cx={x} cy={y} r="3" fill={C.ink} />
          {l && <text x={side === 'l' ? x - 12 : side === 'u' ? x : x + 12} y={side === 'u' ? y - 22 : y + 4}
            text-anchor={side === 'l' ? 'end' : side === 'u' ? 'middle' : 'start'} fill={C.ink} font-weight="600" font-size="11.5">{l}</text>}
        </g>
      ))}
      <!-- arrow to UMAP -->
      <path d="M352 200 H 376" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      {umap.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="2.4" fill={p.c} opacity=".7" />)}
      <g font-weight="700" font-size="12" fill={C.ink}>
        <text x="470" y="84" text-anchor="middle">SMC</text>
        <text x="600" y="162" text-anchor="middle">Fibroblast</text>
        <text x="450" y="306" text-anchor="middle">Endothelial</text>
        <text x="560" y="352" text-anchor="middle">Immune</text>
      </g>
      <text x="470" y="386" text-anchor="middle" font-size="11">segment-specific programs · embryonic origin · disease loci</text>
    </g>
  )}

  {kind === 'perturb' && (
    <g>
      <!-- guide pool -->
      <path d="M40 120 H130 V150 C130 230, 40 230, 40 150 Z" fill="#fff" stroke={C.ink} stroke-opacity=".35" stroke-width="1.6" />
      {Array.from({ length: 14 }, (_, i) => {
        const x = 52 + (i % 4) * 20 + (Math.floor(i / 4) % 2) * 8, y = 138 + Math.floor(i / 4) * 16;
        return <path d={`M${x} ${y} h10 q5 0 5 -5 q0 -5 -5 -5`} fill="none" stroke={guides[i % guides.length]} stroke-width="2.4" stroke-linecap="round" />;
      })}
      <text x="85" y="248" text-anchor="middle" fill={C.ink} font-weight="700" font-size="12.5">sgRNA library</text>
      <text x="85" y="264" text-anchor="middle" font-size="11">CAD genes · enhancers</text>
      <path d="M142 170 H 176" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      <!-- cells -->
      {Array.from({ length: 12 }, (_, i) => {
        const x = 204 + (i % 3) * 36 + (Math.floor(i / 3) % 2) * 16, y = 110 + Math.floor(i / 3) * 34;
        return (
          <g>
            <circle cx={x} cy={y} r="14" fill="#fbe1e4" stroke={C.red} stroke-width="1.5" />
            <circle cx={x} cy={y} r="5" fill={guides[i % guides.length]} />
          </g>
        );
      })}
      <text x="240" y="264" text-anchor="middle" fill={C.ink} font-weight="700" font-size="12.5">dCas9-KRAB SMCs</text>
      <text x="240" y="280" text-anchor="middle" font-size="11">one perturbation per cell</text>
      <path d="M300 170 H 334" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      <!-- heatmap -->
      {heat.map((h) => <rect x={350 + h.x * 13} y={100 + h.y * 13} width="12" height="12" rx="1.5" fill={heatColor(h.v)} />)}
      <text x="428" y="248" text-anchor="middle" fill={C.ink} font-weight="700" font-size="12.5">single-cell readout</text>
      <text x="428" y="264" text-anchor="middle" font-size="11">perturbation × gene</text>
      <path d="M514 170 H 540" stroke={C.ink} stroke-width="1.6" opacity=".45" marker-end={`url(#arr-${kind})`} />
      <!-- programs -->
      {[[C.red, 62], [C.vein, 44], [C.plaque, 30], [C.endo, 52]].map(([c, w], i) => (
        <rect x="552" y={112 + i * 26} width={w} height="16" rx="8" fill={c as string} opacity=".85" />
      ))}
      <text x="584" y="248" text-anchor="middle" fill={C.ink} font-weight="700" font-size="12.5">programs</text>
      <!-- assays -->
      <g font-size="11.5" font-weight="700">
        {[['Parse Perturb-seq', 'promoters · HCASMC', C.red], ['TAP-seq', 'enhancers · targeted', C.vein], ['in vivo Perturb-seq', 'AAV · mouse aorta', C.endo]].map(([t, s, c], i) => (
          <g transform={`translate(${60 + i * 184} 318)`}>
            <rect width="168" height="50" rx="12" fill="#fff" stroke={c as string} stroke-width="1.5" />
            <text x="84" y="22" text-anchor="middle" fill={c as string}>{t}</text>
            <text x="84" y="39" text-anchor="middle" font-weight="500" font-size="10.5">{s}</text>
          </g>
        ))}
      </g>
      <text x="320" y="392" text-anchor="middle" font-size="10.5" letter-spacing="1.2" font-weight="700">IGVF CONSORTIUM</text>
    </g>
  )}
  </g>
</svg>
